# TryOnHub Backend — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./tryon_db.sqlite
# DATABASE_URL=postgresql://user:password@host:5432/tryon_db

# Security — Generate a strong key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-64-char-hex-string-before-deploying-to-prod

# JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google Gemini Vision API
GEMINI_API_KEY=your-gemini-api-key-here

# Base URL for static file serving (no trailing slash)
# Local:      http://127.0.0.1:8000
# Production: https://your-backend.onrender.com
BASE_URL=http://127.0.0.1:8000

# CORS — JSON list of allowed frontend origins
# Local:      ["http://localhost:3000","http://127.0.0.1:3000"]
# Production: ["https://your-frontend.vercel.app"]
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# File upload limits
MAX_UPLOAD_SIZE_MB=10
