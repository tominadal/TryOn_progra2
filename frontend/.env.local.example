# TryOnHub Frontend — Environment Variables
# Next.js reads NEXT_PUBLIC_* variables at build time.
# Variables without NEXT_PUBLIC_ are only available on the server.

# Backend API URL (must be accessible from the browser)
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Production (uncomment and set your Render URL):
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com/api/v1
